<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key><true/>
	<key>com.apple.security.files.user-selected.read-only</key><true/>
	<!-- JavaScriptCore runs highlighting 20-30x slower without JIT (milestone 2 research). -->
	<key>com.apple.security.cs.allow-jit</key><true/>
	<!-- Settings from the app's defaults domain; app groups don't work with ad-hoc signing. -->
	<key>com.apple.security.temporary-exception.shared-preference.read-only</key>
	<array><string>com.mdrum.infiniview</string></array>
	<!-- Folder Checks: ask the background helper (ADR-0005). -->
	<key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
	<array><string>com.mdrum.infiniview.helper</string></array>
</dict>
</plist>
